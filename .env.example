# goXero configuration
APP_NAME=goxero
APP_ENV=development
LOG_LEVEL=info

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s

DB_HOST=localhost
DB_PORT=5432
DB_USER=goxero
DB_PASSWORD=goxero
DB_NAME=goxero
DB_SSL_MODE=disable
DB_MAX_CONNECTIONS=25
DB_MIN_CONNECTIONS=5
DB_MAX_CONN_LIFETIME=1h

# In production APP_ENV=production the app refuses to boot if JWT_SECRET is
# left at the insecure default below — generate with `openssl rand -hex 32`.
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=720h
TENANT_HEADER=Xero-Tenant-Id

# --- Bank feed integration (optional) -------------------------------------
# Leaving these blank disables the related adapter.
# GoCardless Bank Account Data (ex-Nordigen) — PSD2 aggregator, EU/UK banks.
# Register at https://bankaccountdata.gocardless.com/user-secrets/ to obtain
# secret_id / secret_key, then the app will pick it up at boot.
GOCARDLESS_BAD_SECRET_ID=
GOCARDLESS_BAD_SECRET_KEY=

# Plaid — the US/Canada aggregator. Get client_id/secret from
# https://dashboard.plaid.com/developers/keys; PLAID_ENV=sandbox gives you
# Plaid's test institutions (user_good / pass_good) without touching a real
# bank. Requires BANKFEED_ENCRYPTION_KEY below, because Plaid issues a bearer
# access token per connected bank that has to be sealed before it is stored.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Shown to the user inside Plaid's consent screen. Plaid truncates past 30 chars.
PLAID_CLIENT_NAME=goxero
# The public URL Plaid posts webhooks to, e.g.
# https://goxero.example/api/v1/bank-feeds/webhooks/plaid. Leave it blank when
# this deployment is not reachable from the internet: the browser coming back
# from consent then does the same work, just without hearing about a connection
# the bank breaks later. Plaid signs every delivery, so the endpoint needs no
# other credential. This must be reachable from the internet: Plaid accepts the
# URL whatever it looks like — it takes http, a bare host and even localhost —
# so a URL it cannot actually reach fails silently instead of being refused.
PLAID_WEBHOOK_URL=

# Key used to encrypt per-connection provider secrets (AES-256-GCM). Any
# sufficiently long random string — it is hashed down to a 256-bit key. Changing
# it makes every stored token undecryptable, so existing bank feeds have to be
# reconnected.
BANKFEED_ENCRYPTION_KEY=
# Where the bank consent UI sends the browser after the user confirms.
BANKFEED_REDIRECT_URL=http://localhost:5173/app/bank-feeds/callback
# How far back to pull statement lines on every /sync call.
BANKFEED_SYNC_WINDOW=2160h
# How often every linked connection is refreshed in the background. "0" turns
# the background poller off and leaves syncing to the Sync button.
BANKFEED_SYNC_INTERVAL=6h
